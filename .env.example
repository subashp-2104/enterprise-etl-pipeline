# ETL Pipeline Configuration

# Run in mock mode (generates realistic data) or live mode
MOCK_MODE=True

# Database Configuration
# Local fallback: sqlite:///./warehouse.db
# Docker Postgres: postgresql://postgres:postgres@db:5432/warehouse
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warehouse

# API Credentials (used if MOCK_MODE=False)
STRIPE_API_KEY=your_stripe_api_key_here

SALESFORCE_USERNAME=your_sf_username_here
SALESFORCE_PASSWORD=your_sf_password_here
SALESFORCE_SECURITY_TOKEN=your_sf_security_token_here
SALESFORCE_CLIENT_ID=your_sf_client_id_here
SALESFORCE_CLIENT_SECRET=your_sf_client_secret_here
SALESFORCE_DOMAIN=login # or test for sandbox

# Raw Data Storage Configuration (local or s3)
RAW_STORAGE_TYPE=local
RAW_STORAGE_PATH=./raw_data

# S3 Configuration (only used if RAW_STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=my-enterprise-etl-bucket

# Slack Webhook for Alerts
SLACK_WEBHOOK_URL=
